# Base URL of the ZTab API (required)
VITE_API_URL=http://127.0.0.1:3000
# test | main (required)
VITE_NETWORK=test
# Optional block explorer tx link prefix, e.g. https://explorer.example/tx/
VITE_EXPLORER_TX_URL=
# Reserved, leave unset
# VITE_DEMO_PAYMENT=
# Set to 1 to serve the dev server over self-signed HTTPS
# VITE_HTTPS=
