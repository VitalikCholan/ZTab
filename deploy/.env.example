# deploy/.env — created by deploy/init-env.sh (mode 600, git-ignored). Never commit the real file.

# Public hostname Caddy serves and gets a Let's Encrypt certificate for (A record -> this server).
# A *.sslip.io host (e.g. 203-0-113-7.sslip.io) is a throwaway rehearsal host: no HSTS is sent.
DOMAIN=ztab.example
# Contact email for the Let's Encrypt account (expiry and problem notices).
ACME_EMAIL=you@example.com
# Postgres password for the `ztab` role; generated with `openssl rand -hex 32`.
POSTGRES_PASSWORD=change-me
# Shared bearer between the API (WATCHER_TOKEN) and the watcher (ZTAB_API_TOKEN); `openssl rand -hex 32`.
# Do not rotate it while the stack runs without restarting both services.
WATCHER_TOKEN=change-me
# Image tag pulled from ghcr.io/vitalikcholan/ztab-{api,watcher,pwa}: main, sha-<short>, or v*.
# update.sh writes sha-<short> of the pulled main; roll back by setting an older sha- and `up -d`.
IMAGE_TAG=main
